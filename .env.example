# PaperCortex Configuration
# Copy this file to .env and fill in your values

# Paperless-ngx connection
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=your-paperless-api-token-here

# Ollama connection
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optionales multimodales Modell fuer Fotobelege mit schlechtem OCR
# (z. B. minicpm-v oder llava). Wenn gesetzt, liest PaperCortex das
# Belegbild direkt, sobald der OCR-Text zu duenn ist.
# OLLAMA_VISION_MODEL=minicpm-v

# Vector store
VECTOR_DB_PATH=./data/vectors.db

# MCP Server
MCP_SERVER_PORT=3100

# Logging
LOG_LEVEL=info

# DATEV export (optional overrides -- the recommended way is: npm run datev:init,
# which stores everything in data/config.json)
# DATEV_CONSULTANT_NUMBER=12345
# DATEV_CLIENT_NUMBER=67890
# DATEV_SKR=SKR03
# DATEV_FISCAL_YEAR_START_MONTH=1
# DATEV_MONEY_ACCOUNT=1200
# PAPERCORTEX_DATA_DIR=./data
# PAPERCORTEX_EXPORT_DIR=./exports

# Web UI (Einstellungsseite + DATEV-Export im Browser)
# WEBUI_ENABLED=true
# WEBUI_PORT=8140
# Optionaler Zugangscode; ohne ihn ist die Seite im LAN offen. NICHT ins
# Internet exponieren.
# WEBUI_TOKEN=
# Zusaetzlich erlaubte Hostnamen/IPs fuer den Browserzugriff (Schutz gegen
# DNS-Rebinding). Noetig, sobald die Seite nicht ueber localhost geoeffnet
# wird, z. B.: WEBUI_ALLOWED_HOSTS=unraid.local (Hostname oder LAN-IP, kommagetrennt)
# WEBUI_ALLOWED_HOSTS=
